# The Zenodo record that all five *-files.sh scripts download from.
#
# This is the single place the record is written down — the scripts source this file
# rather than each carrying their own copy of the URL, so moving the payload to a new
# record (or to a mirror) is a one-line change here.
#
# TODO: point at the new record once the payload is uploaded (see make-zenodo-payload.sh).
ZENODO_RECORD=21869381

ZENODO=https://zenodo.org/records/$ZENODO_RECORD/files

# ground-truth-evidence.tar.gz — the per-site notes behind the manual ground truth — was
# published with the ASE'25 record and is unchanged, so download-files.sh takes that one file
# from there rather than have it uploaded twice. Zenodo records are permanent, so this stays
# resolvable independently of the record above.
ZENODO_GT_RECORD=16992345

ZENODO_GT=https://zenodo.org/records/$ZENODO_GT_RECORD/files
